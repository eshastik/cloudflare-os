{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-mnemos",
  "main": "src/mnemos.ts",
  "rules": [{"type":"Text","globs":["**/*.txt"],"fallthrough":true}],
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "migrations": [{"tag": "v0", "new_sqlite_classes": ["UserAccount"]}, {"tag": "v1", "new_sqlite_classes": ["MnemosNativeDocumentSource"]}, {"tag": "v2", "new_sqlite_classes": ["TelegramBot"]}, {"tag":"v3","new_sqlite_classes":["TelegramPoller"]}]
}
