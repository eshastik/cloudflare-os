{
  "name": "@gadgets/backend-utils",
  "version": "1.0.0",
  "description": "Shared Worker-side libraries; not a standalone deployable Worker.",
  "type": "module",
  "exports": {
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./src/logger.ts"
    },
    "./observability-context": {
      "types": "./src/observability-context.ts",
      "import": "./src/observability-context.ts"
    },
    "./tracing": {
      "types": "./src/tracing.ts",
      "import": "./src/tracing.ts"
    },
    "./error-reporting": {
      "types": "./src/error-reporting.ts",
      "import": "./src/error-reporting.ts"
    },
    "./postgres-text-kv": {
      "types": "./src/postgres-text-kv.ts",
      "import": "./src/postgres-text-kv.ts"
    },
    "./postgres-actor-kv": {
      "types": "./src/postgres-actor-kv.ts",
      "import": "./src/postgres-actor-kv.ts"
    },
    "./postgres-binary-kv": {
      "types": "./src/postgres-binary-kv.ts",
      "import": "./src/postgres-binary-kv.ts"
    },
    "./postgres-state": {
      "types": "./src/postgres-state.ts",
      "import": "./src/postgres-state.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "types:check": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gadgets/error-reporting": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/pg": "8.15.5",
    "vitest": "^4.1.10"
  }
}
