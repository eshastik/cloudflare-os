    "@gadgets/workshop-shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260801.0-alpha"
  },
  "main": "src/yandex.ts"
}
